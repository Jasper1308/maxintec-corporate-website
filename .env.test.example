# Use only a dedicated Supabase test project or local Supabase instance.
NEXT_PUBLIC_SUPABASE_URL=https://your-test-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-test-anon-key

# Optional when the test application is already running elsewhere.
# E2E_BASE_URL=https://your-deployed-test-app.example.test

E2E_RESIDENT_EMAIL=resident-a@example.test
E2E_RESIDENT_PASSWORD=replace-with-test-password

E2E_MANAGER_EMAIL=manager-a@example.test
E2E_MANAGER_PASSWORD=replace-with-test-password

E2E_ADMIN_EMAIL=admin@example.test
E2E_ADMIN_PASSWORD=replace-with-test-password
