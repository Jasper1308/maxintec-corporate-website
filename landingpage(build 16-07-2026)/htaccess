RewriteEngine On

# ==============================
# EVITAR CACHE DE PÁGINAS HTML
# ==============================
<FilesMatch "\.(html|htm)$">
    <IfModule mod_headers.c>
        # Força o navegador e proxies a validarem o arquivo a cada requisição
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </IfModule>
</FilesMatch>

# ==============================
# ROTAS PERSONALIZADAS
# ==============================

RewriteRule ^lp-spi$ fire.html [L]
RewriteRule ^lp-srap$ aspiration.html [L]

# ==============================
# CORE (nao mexer)
# ==============================

# Se for arquivo ou pasta real, nao mexe
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Rotas padrao (.html)
RewriteRule ^(.*)$ $1.html [L]

# ==============================
# SEGURANÇA
# ==============================

Options -Indexes

<FilesMatch "\.(htaccess|htpasswd|env|git)">
  Order Allow,Deny
  Deny from all
</FilesMatch>